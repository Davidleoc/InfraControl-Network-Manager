# Copie para .env (Docker) ou .env.local (npm run dev) e preencha com os dados do seu ambiente.
# NUNCA versione o arquivo preenchido.

# --- Interface ---
NEXT_PUBLIC_APP_NAME=InfraControl Network Manager
NEXT_PUBLIC_APP_SUBTITLE=Gestão Integrada de IPs, DNS e Inventário CMDB
NEXT_PUBLIC_COMPANY_NAME=Minha Empresa

# --- Jira Service Management (Assets/Insight) ---
JIRA_URL=https://jira.example.com
JIRA_TOKEN=
JIRA_VLAN_TYPE=VLAN
JIRA_HOSTNAME_TYPE=Nome de ativo
# Opcionais: IDs do seu schema CMDB (descobertos automaticamente quando possível)
JIRA_HOSTNAME_TYPE_ID=
JIRA_STATUS_ATTR_ID=
JIRA_STATUS_ID_AVAILABLE=
JIRA_STATUS_ID_RESERVED=
JIRA_STATUS_ID_IN_USE=
JIRA_IP_ATTRIBUTE_NAME=Endereço IP
# true apenas se o Jira usar certificado autoassinado/CA interna
ALLOW_SELF_SIGNED_CERTS=false

# --- LDAP / Active Directory ---
LDAP_URL=ldap://dc.example.com:389
LDAP_BIND_DN=CN=svc-ipmanager,OU=Service Accounts,DC=example,DC=com
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=DC=example,DC=com

# --- Segurança ---
# Gere com: openssl rand -base64 48
JWT_SECRET=
COOKIE_NAME=infracontrol_auth_token

# --- E-mail de backup semanal (destinatários em emails.txt) ---
EMAIL_TRANSPORT_DEFAULT_HOST=smtp.example.com
EMAIL_TRANSPORT_DEFAULT_PORT=587
EMAIL_TRANSPORT_DEFAULT_TLS=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_DEFAULT_FROM_MAIL=noreply@example.com
# Dia da semana do envio (0=domingo, 1=segunda, ...)
EMAIL_BACKUP_DAY=1
